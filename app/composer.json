{
    "name": "davyn/app",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "azuyalabs/yasumi": "^2.7",
        "sabre/dav": "^4.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Davyn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Davyn\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
