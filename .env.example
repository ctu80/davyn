# ─────────────────────────────────────────────────────────────────────────────
# Davyn configuration. Copy this file to `.env` and edit the values:
#
#     cp .env.example .env
#     # set APP_SECRET (see below), then:
#     docker compose pull
#     docker compose up -d
#
# Every key is optional unless marked REQUIRED; omitted keys fall back to the
# image's built-in defaults. `.env` is gitignored. Database and certificate paths
# are fixed inside the image (persisted via the davyn_data / davyn_config volumes)
# and are intentionally not configured here.
# ─────────────────────────────────────────────────────────────────────────────

# Display name of the instance (branding can also be changed later in the UI).
APP_NAME=Davyn

# Environment: `production` (secure cookies, APP_SECRET enforced) or `dev`
# (relaxed, for local plain-HTTP testing). Use `production` for any real deploy.
APP_ENV=production

# REQUIRED in production: a random secret, at least 32 characters. The app refuses
# to start in production without it. Generate one with:
#     openssl rand -hex 32
APP_SECRET=

# Public base URL the instance is reached at, e.g. https://dav.example.com
# (typically the address of your reverse proxy). Used for DAV setup links, public
# calendar links and QR codes. Leave empty to derive it from the request, or set
# it later under Settings → Security → Public / Base URL.
BASE_URL=

# ── Published host ports ────────────────────────────────────────────────────
# The container listens internally on 8080 (HTTP) and 8443 (HTTPS). These are the
# HOST ports they are published on — change them to publish elsewhere (e.g. 80 / 443).
HOST_HTTP_PORT=8080
HOST_HTTPS_PORT=8443

# ── Database ────────────────────────────────────────────────────────────────
# SQLite is the only supported driver in this release. The database file lives in
# the davyn_data volume; there is nothing to configure here.
DB_DRIVER=sqlite

# ── Sessions & cookies ──────────────────────────────────────────────────────
SESSION_NAME=davyn_session
COOKIE_SAMESITE=Lax
# Secure cookies are auto-enabled when APP_ENV=production. If you are testing over
# plain HTTP (no TLS / reverse proxy) you must set this to false, or login cookies
# will not be sent by the browser.
# COOKIE_SECURE=false

# ── Backups ─────────────────────────────────────────────────────────────────
# Fallback retention for the bin/prune-backups.php CLI. The in-app Backups
# settings (Admin → Backups) override these for scheduled backups.
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP=5

# ── Holiday calendars (optional) ────────────────────────────────────────────
# Per-user, rolling holiday subscriptions: how many years to keep behind / ahead.
HOLIDAY_YEARS_BACK=1
HOLIDAY_YEARS_AHEAD=2
# Generate the next year lazily as it comes into range (cheap guard on list load).
HOLIDAY_AUTO_GENERATE=true
# Default locale for holiday names (Yasumi locale, e.g. de_DE, en_US, fr_FR).
HOLIDAY_DEFAULT_LOCALE=de_DE
#
# Optional host cron for rolling generation across all users:
#   0 3 * * * cd /path/to/davyn && docker compose exec -T davyn php bin/generate-holidays.php --all-users
